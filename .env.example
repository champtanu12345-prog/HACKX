# ==============================================================================
# HACKX - Oil Spill Intelligence & Attribution System
# Environment Configuration
# ==============================================================================

# Application
PROJECT_NAME="HACKX Oil Spill Intelligence"
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_STR=/api/v1

# Database Configuration
# Local development fallback: sqlite:///./hackx.db
# Production / Docker PostGIS: postgresql+psycopg://hackx:hackx_secret@localhost:5432/hackx_db
DATABASE_URL=sqlite:///./hackx.db

# Provider Simulation & API Keys
ENABLE_SYNTHETIC_DATA=true
COPERNICUS_API_USER=""
COPERNICUS_API_PASSWORD=""
SPIRE_AIS_API_KEY=""
NOAA_GFS_API_URL="https://nomads.ncep.noaa.gov/dods/gfs_0p25"

# ML Inference
DEVICE=cpu
MODEL_WEIGHTS_PATH="./ml/models/weights/unet_spill_s1_v1.pt"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:5174", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:5174"]

# ==============================================================================
# Real Email (Gmail / SMTP) OTP Delivery Configuration
# ==============================================================================
# To deliver real OTP emails to any Gmail / Email inbox:
# 1. Open Google Account -> Security -> 2-Step Verification -> App Passwords
# 2. Generate a 16-character App Password for 'Mail'
# 3. Enter your Gmail and App Password below:
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS=true

# ==============================================================================
# Real Mobile SMS (+91) OTP Delivery Configuration
# ==============================================================================
# Option A: Fast2SMS Gateway (free signup at https://www.fast2sms.com)
FAST2SMS_API_KEY=""

# Option B: Twilio Gateway
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""
